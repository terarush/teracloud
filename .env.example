# Application configuration
APP_NAME=teracloud
APP_PRODUCTION=false
APP_FRONTEND_URL=http://localhost:3000
SERVER_MODE=debug
PORT=8080
HTTP_TIMEOUT=60
CACHE_EXPIRED=24
CACHE_PURGED=60
API_VERSION=1

# Database
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teracloud
DB_USERNAME=postgres
DB_PASSWORD=secret

# Connection Pool
POOL_CONN_IDLE=200
POOL_CONN_MAX=300
POOL_CONN_LIFETIME=60

# JWT
JWT_DAY_EXPIRED=7
JWT_SIGNATURE_KEY=change-me
JWT_REFRESH_KEY=change-me

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false

# SMTP (for forgot password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# OAuth2 Google
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# MinIO (object storage) — uploads stored in bucket, served directly by MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_USE_SSL=false
MINIO_BUCKET=ruang-tukar
