# Application configuration
APP_NAME=teracloud
APP_PRODUCTION=false
APP_FRONTEND_URL=http://localhost:3000
SERVER_MODE=debug
PORT=8080
HTTP_TIMEOUT=60
CACHE_EXPIRED=24
CACHE_PURGED=60
API_VERSION=1

# Database
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teracloud
DB_USERNAME=postgres
DB_PASSWORD=secret

# Connection Pool
POOL_CONN_IDLE=200
POOL_CONN_MAX=300
POOL_CONN_LIFETIME=60

# JWT
JWT_DAY_EXPIRED=7
JWT_SIGNATURE_KEY=change-me
JWT_REFRESH_KEY=change-me

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false

# SMTP (for forgot password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# OAuth2 Google
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# MinIO (object storage) — uploads stored in bucket, served directly by MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_USE_SSL=false
MINIO_BUCKET=teracloud

# Docker
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_NETWORK=teracloud
DOCKER_VOLUME_BASE=/var/lib/teracloud/volumes
DOCKER_GID=999
DOCKER_PORT_RANGE_START=10000
DOCKER_PORT_RANGE_END=60000

# Midtrans Additional
MIDTRANS_CLIENT_KEY=
MIDTRANS_WEBHOOK_URL=http://localhost:8080/api/v1/webhooks/midtrans

# Billing
BILLING_GRACE_PERIOD_DAYS=3
BILLING_SUSPEND_AFTER_DAYS=7
BILLING_REMINDER_DAYS=7,3,1

# Scheduler
SCHEDULER_STATS_INTERVAL=5m
SCHEDULER_BILLING_CHECK_INTERVAL=1h
SCHEDULER_SYNC_INTERVAL=2m
SCHEDULER_CLEANUP_INTERVAL=24h

# WebSocket
WS_MAX_SESSIONS_PER_CONTAINER=3
WS_IDLE_TIMEOUT=30m
WS_PING_INTERVAL=30s

# Cloudflare Tunnel (optional - for auto subdomain routing per container port)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=
TUNNEL_DOMAIN=terarush.dev